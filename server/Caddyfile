(site) {
	encode gzip
	@app path /app /app/*
	handle @app {
		header {
			Content-Security-Policy "frame-ancestors 'self' https://*.creatium.site https://creatium.io https://*.creatium.io"
			-X-Frame-Options
			Referrer-Policy strict-origin-when-cross-origin
		}
		@html path /app /app/ *.html *.txt
		header @html Cache-Control "no-cache"
		header /app/_next/static/* Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		try_files {path} {path}/index.html {path}.html
		file_server
	}
	handle {
		reverse_proxy api:4000
	}
}
158-160-175-130.sslip.io {
	import site
}
http://158.160.175.130, http:// {
	import site
}
