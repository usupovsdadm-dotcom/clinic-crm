{
  "name": "clinic-crm-desktop",
  "productName": "CRM для клиник",
  "version": "1.0.0",
  "description": "CRM для клиник — настольное приложение",
  "author": "CRM для клиник",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "pe-library": "^0.4.1",
    "resedit": "^1.7.2"
  },
  "build": {
    "appId": "ru.clinic-crm.desktop",
    "productName": "CRM для клиник",
    "artifactName": "CRM-for-clinics-Setup-${version}.exe",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png",
      "!afterPack.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CRM для клиник",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "afterPack": "./afterPack.js"
  }
}